; Engine configuration file.
; Godot 4.3

config_version=5

[application]

config/name="Drachen-Labyrinth"
config/description="Ein Labyrinth mit drehenden Scheiben, Feuerfallen, drei Zwischenbossen und einem endlos kreisenden Drachen."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.035, 0.05, 1)
