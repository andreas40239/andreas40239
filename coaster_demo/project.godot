; Engine configuration file.
; Coaster Demo – Greybox-Prototyp (Godot 4.3)

config_version=5

[application]

config/name="Coaster Demo"
config/description="Isometrischer Achterbahn-Baukasten mit Mitfahr-Modus (Greybox-Demo)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.6.1"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.62, 0.8, 0.96, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
