; Engine configuration file.
; Godzilla: Kaiju Lane Fighter — 2.5D lane-based kaiju beat-'em-up.

config_version=5

[application]

config/name="Kaiju Lane Fighter"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.png"

[autoload]

GameState="*res://autoload/GameState.gd"
AudioManager="*res://autoload/AudioManager.gd"
InputHandler="*res://autoload/InputHandler.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
