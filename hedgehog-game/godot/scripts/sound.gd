extends Node
## Sound effects, ambience and music (autoloaded as "Sound").
## All sounds are generated by tools/generate_sounds.py into res://sounds/.
##
##   Sound.play("chime_fact")                    # plain UI sound
##   Sound.play_at("crunch", global_position)    # positional, in the garden
##   Sound.attach_loop("purr", self)              # looping, follows a node

const DIR := "res://sounds/"
## Sounds with several takes (name_1, name_2, ...); one is picked at random.
const VARIANTS := {"snuffle": 3, "step": 3, "rustle": 3, "bark": 2}
const LOOPS := ["music", "wind", "crickets", "crawl", "purr", "snore", "night"]
const ALL := [
	"snuffle", "step", "rustle", "squeak", "huff", "crunch", "munch", "slurp", "snore",
	"bush", "crawl", "crickets", "meow", "meow_sleepy", "meh", "hiss", "purr", "bell",
	"bark", "wind", "gust", "chime_checkpoint", "chime_fact", "chime_step", "star", "poof", "music",
	"yelp", "woof", "hoot", "swoop", "night",
]

const MUSIC_DB := -13.0
const CRICKETS_DB := -22.0
## Wind loudness at strength 0 and 1.
const WIND_QUIET_DB := -30.0
const WIND_LOUD_DB := -6.0

var _cache := {}
var _music: AudioStreamPlayer
var _wind: AudioStreamPlayer
var _crickets: AudioStreamPlayer
var _wind_strength := 0.0
var _gust_timer := 8.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "Ambience", "SFX"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			AudioServer.set_bus_name(AudioServer.bus_count - 1, bus)
			AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
	_music = _make_player("music", "Music", MUSIC_DB)
	_wind = _make_player("wind", "Ambience", WIND_QUIET_DB)
	_crickets = _make_player("crickets", "Ambience", CRICKETS_DB)


## Starts music and ambience (called when a level starts; keeps playing
## across restarts so the music doesn't jump).
func start_level_audio(night := false) -> void:
	preload_all()
	# Night gardens have their own insect chorus.
	var insects := stream("night" if night else "crickets")
	if _crickets.stream != insects:
		_crickets.stream = insects
		_crickets.stop()
	for player in [_music, _wind, _crickets]:
		if not player.playing:
			player.play()
	set_wind(0.0)
	set_insects(1.0)


## Just the music (title screen).
func start_music() -> void:
	preload_all()
	if not _music.playing:
		_music.play()
	_wind.stop()
	_crickets.stop()


## Loads every sound up front, so nothing is read from storage mid-game
## (that can cause a hitch on phones, e.g. the first time the cat catches you).
func preload_all() -> void:
	for sound in ALL:
		if VARIANTS.has(sound):
			for i in range(1, VARIANTS[sound] + 1):
				_load_file("%s_%d" % [sound, i], sound)
		else:
			_load_file(sound, sound)


func stream(sound: String) -> AudioStream:
	var file := sound
	if VARIANTS.has(sound):
		file = "%s_%d" % [sound, randi_range(1, VARIANTS[sound])]
	return _load_file(file, sound)


func _load_file(file: String, sound: String) -> AudioStream:
	if not _cache.has(file):
		var loaded: AudioStream = load(DIR + file + ".ogg")
		if loaded is AudioStreamOggVorbis:
			loaded.loop = LOOPS.has(sound)
		_cache[file] = loaded
	return _cache[file]


## Plays a sound that isn't anywhere in particular (UI, chimes).
func play(sound: String, volume_db := 0.0, pitch := 1.0, pitch_jitter := 0.0) -> void:
	var player := AudioStreamPlayer.new()
	player.stream = stream(sound)
	player.bus = "SFX"
	player.volume_db = volume_db
	player.pitch_scale = pitch * (1.0 + randf_range(-pitch_jitter, pitch_jitter))
	add_child(player)
	player.finished.connect(player.queue_free)
	player.play()


## Plays a one-shot sound at a place in the garden.
func play_at(sound: String, position: Vector3, volume_db := 0.0, pitch_jitter := 0.08,
		max_distance := 30.0) -> void:
	var player := AudioStreamPlayer3D.new()
	player.stream = stream(sound)
	player.bus = "SFX"
	player.volume_db = volume_db
	player.max_distance = max_distance
	player.unit_size = 4.0
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	add_child(player)
	player.global_position = position
	player.finished.connect(player.queue_free)
	player.play()


## A looping sound that follows `parent` (a beetle crawling, a purring cat).
## Returns the player so the caller can stop or start it.
func attach_loop(sound: String, parent: Node3D, volume_db := 0.0, max_distance := 8.0) -> AudioStreamPlayer3D:
	var player := AudioStreamPlayer3D.new()
	player.stream = stream(sound)
	player.bus = "SFX"
	player.volume_db = volume_db
	player.max_distance = max_distance
	player.unit_size = 2.0
	parent.add_child(player)
	return player


## 0 = a light breeze, 1 = a strong winter wind with frequent gusts.
func set_wind(strength: float) -> void:
	_wind_strength = clampf(strength, 0.0, 1.0)
	_wind.volume_db = lerpf(WIND_QUIET_DB, WIND_LOUD_DB, _wind_strength)
	_wind.pitch_scale = lerpf(0.9, 1.25, _wind_strength)


## 1 = crickets chirping, 0 = silent (they go quiet as winter comes).
func set_insects(amount: float) -> void:
	amount = clampf(amount, 0.0, 1.0)
	_crickets.volume_db = linear_to_db(maxf(amount, 0.0001)) + CRICKETS_DB


func set_music_volume(db: float) -> void:
	_music.volume_db = db


func _process(delta: float) -> void:
	# Gusts come more often and louder as the wind picks up.
	_gust_timer -= delta
	if _gust_timer <= 0.0 and _wind.playing:
		_gust_timer = lerpf(18.0, 4.0, _wind_strength) * randf_range(0.7, 1.3)
		if _wind_strength > 0.15:
			play("gust", lerpf(-22.0, -4.0, _wind_strength), 1.0, 0.15)


func _exit_tree() -> void:
	# Stop everything so no playback outlives the engine at quit.
	for child in get_children():
		child.stop()
	_cache.clear()


func _make_player(sound: String, bus: String, volume_db: float) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.stream = stream(sound)
	player.bus = bus
	player.volume_db = volume_db
	add_child(player)
	return player
