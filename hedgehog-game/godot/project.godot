; Engine configuration file.
; Input actions are registered at startup by scripts/game.gd (autoload "Game").

config_version=5

[application]

config/name="Hedgehog Highways (Prototype)"
config/description="Grey-box prototype of the core loop: forage, avoid the cat, build a nest, hibernate."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Sound="*res://scripts/sound.gd"

[display]

window/handheld/orientation=4

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="animals"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
