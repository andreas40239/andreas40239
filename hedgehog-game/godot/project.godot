; Engine configuration file.
; Input actions are registered at startup by scripts/game.gd (autoload "Game").

config_version=5

[application]

config/name="Hedgehog Highways (Prototype)"
config/description="Grey-box prototype of the core loop: forage, avoid the cat, build a nest, hibernate."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="animals"

[rendering]

anti_aliasing/quality/msaa_3d=2
