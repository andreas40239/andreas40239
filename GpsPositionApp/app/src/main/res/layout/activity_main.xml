<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Top status bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <TextView
                android:id="@+id/tvOfflineBadgeStrike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wlan_label"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/offline_label"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_for_fix"
            android:textColor="@color/accent_green"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Speed block -->
    <LinearLayout
        android:id="@+id/speedBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/compassBlock"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/text_primary"
            android:textSize="88sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_unit"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:layout_marginTop="-8dp" />
    </LinearLayout>

    <!-- Compass block -->
    <LinearLayout
        android:id="@+id/compassBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/speedBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/coordCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/north_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/compass_ring"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/ivNeedle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/compass_needle"
                android:contentDescription="@null" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/compass_center_dot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvDegree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompassLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Coordinates card -->
    <LinearLayout
        android:id="@+id/coordCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/lat_label"
                android:textColor="@color/text_muted"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLatitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/lon_label"
                android:textColor="@color/text_muted"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLongitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
